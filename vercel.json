{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{index.html,logo_candidates.html,css/**,js/**,assets/**,data/**}"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
